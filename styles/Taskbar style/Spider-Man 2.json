        "Stroke=#FF1E3254",
        "StrokeThickness=1",
        "RadiusX=0",
        "RadiusY=0",
        "Height=Auto",
        "VerticalAlignment=Stretch",
        "HorizontalAlignment=Stretch",
        "RenderTransformOrigin=0.5,0.5",
        "RenderTransform:=<SkewTransform AngleX=\"-16\" />",
        "Margin={{gtaRailHeight > 0 ? gtaRailHeight * 0.143373 + 1 : 7}},0,{{gtaRailHeight > 0 ? gtaRailHeight * 0.143373 + 1 : 7}},0",
        "IsHitTestVisible=False",
        "Fill:=<LinearGradientBrush StartPoint=\"0,0.5\" EndPoint=\"1,0.5\"><GradientStop Color=\"#FFE62429\" Offset=\"0\" /><GradientStop Color=\"#FFE62429\" Offset=\"{{gtaAccentWidth > 0 ? 4 / gtaAccentWidth : 0.01}}\" /><GradientStop Color=\"#00E62429\" Offset=\"{{gtaAccentWidth > 0 ? 4 / gtaAccentWidth : 0.01}}\" /><GradientStop Color=\"#00E62429\" Offset=\"{{gtaAccentWidth > 0 ? 1 - 4 / gtaAccentWidth : 0.99}}\" /><GradientStop Color=\"#FFE62429\" Offset=\"{{gtaAccentWidth > 0 ? 1 - 4 / gtaAccentWidth : 0.99}}\" /><GradientStop Color=\"#FFE62429\" Offset=\"1\" /></LinearGradientBrush>",
        "ActualWidth=>gtaAccentWidth"
      ]
    },
