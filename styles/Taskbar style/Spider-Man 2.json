{
  "id": "Spider-Man 2",
  "label": "Spider-Man 2",
  "author": "CoreDesk Engine",
  "version": 1,
  "targetStyles": [
    {
      "target": "Taskbar.TaskbarFrame",
      "styles": [
        "Width=Auto",
        "HorizontalAlignment=Center",
        "Margin=220,0,220,0"
      ]
    },
    {
      "target": "Taskbar.TaskbarFrame > Grid#RootGrid",
      "styles": [
        "Background=Transparent",
        "BorderBrush=#FF1E3254",
        "BorderThickness=0",
        "CornerRadius=0",
        "Margin=0,4,0,4",
        "Padding=24,0,24,0",
        "ActualHeight=>gtaRailHeight"
      ]
    },
    {
      "target": "Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground",
      "styles": [
        "Margin=-24,0,-24,0",
        "IsHitTestVisible=False"
      ]
    },
    {
      "target": "Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground > Grid > Rectangle#BackgroundFill",
      "styles": [
        "Visibility=Visible",
        "Fill=#EE070B14",
        "RadiusX=0",
        "RadiusY=0",
        "RenderTransformOrigin=0.5,0.5",
        "RenderTransform:=<SkewTransform AngleX=\"-16\" />",
        "Margin={{gtaRailHeight > 0 ? gtaRailHeight * 0.143373 + 1 : 7}},0,{{gtaRailHeight > 0 ? gtaRailHeight * 0.143373 + 1 : 7}},0",
        "IsHitTestVisible=False"
      ]
    },
    {
      "target": "Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground > Grid > Rectangle#BackgroundStroke",
      "styles": [
